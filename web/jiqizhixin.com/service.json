{
  "domain": "jiqizhixin.com",
  "name": "机器之心",
  "description": "Browse, search, and read public AI and technology articles from 机器之心.",
  "baseUrl": "https://www.jiqizhixin.com/robots.txt",
  "actions": [
    {
      "id": "listArticles",
      "label": "List articles",
      "description": "List the latest public articles from 机器之心. The source currently ignores pagination, so this action returns only the latest batch.",
      "requireAuth": false,
      "requireApproval": false,
      "defaultArgs": {
        "limit": 20
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 20,
            "description": "Maximum number of articles to return."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "author": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "source": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "category": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "publishedAt": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "excerpt": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "coverImageUrl": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "url": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title",
                "author",
                "source",
                "category",
                "publishedAt",
                "tags",
                "excerpt",
                "coverImageUrl",
                "url"
              ],
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "type": "null"
          },
          "totalCount": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "items",
          "nextCursor",
          "totalCount"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "searchArticles",
      "label": "Search articles",
      "description": "Search public 机器之心 articles by keyword. The source returns up to three matches and does not paginate.",
      "requireAuth": false,
      "requireApproval": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Article search query."
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "author": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "source": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "category": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "publishedAt": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "excerpt": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "coverImageUrl": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "url": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title",
                "author",
                "source",
                "category",
                "publishedAt",
                "tags",
                "excerpt",
                "coverImageUrl",
                "url"
              ],
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "type": "null"
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "getArticle",
      "label": "Get article",
      "description": "Read one public 机器之心 article by an ID returned from list or search.",
      "requireAuth": false,
      "requireApproval": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[0-9a-fA-F-]+$",
            "description": "Article ID returned by listArticles or searchArticles."
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "author": {
            "type": [
              "string",
              "null"
            ]
          },
          "publishedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "copyright": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "content": {
            "type": "string"
          },
          "coverImageUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "likesCount": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "author",
          "publishedAt",
          "copyright",
          "description",
          "content",
          "coverImageUrl",
          "tags",
          "likesCount",
          "url"
        ],
        "additionalProperties": false
      }
    }
  ]
}
